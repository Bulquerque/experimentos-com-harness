{
  "name": "@nhs/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --experimental-strip-types --watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test --test-concurrency=1 src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "typescript": "^5.8.3"
  }
}
