# NUNCA inclua sua chave no frontend ou em git.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# true = indexação e busca semântica com NIM. false = RAG lexical local.
RAG_USE_EMBEDDINGS=false
# Busca Brave opcional; em demo os argumentos usam uma simulação local.
BRAVE_SEARCH_API_KEY=
PORT=3000
# NIM simulado nos testes automatizados — sem chave real e sem modelo local.
