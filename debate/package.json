    "audit:assets": "node scripts/audit-assets.js",
    "build:offline": "python3 scripts/build-offline-v18.py",
    "test:offline": "python3 scripts/test_offline.py",
    "test:offline:full": "python3 scripts/test_offline_full.py",
    "preview:offline": "node scripts/serve-offline.js",
    "test:reader": "python3 scripts/test_reader_v17.py",
    "test:menu": "python3 scripts/test_menu_v18.py",
    "test:court-ui": "python3 scripts/test_court_v19.py",
    "test:court-sessions": "python3 scripts/test_court_sessions_v21.py",
    "doctor:nim": "node scripts/doctor-nim.js",
