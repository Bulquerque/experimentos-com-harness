{
  "name": "contraponto",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "Contraponto v24: 128 quadros RGBA normalizados por escala facial, backups integrais de arte, harness NIM/Tribunal preservada.",
  "scripts": {
    "start": "node server/index.js",
